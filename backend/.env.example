DEBUG=True
SECRET_KEY=change-me-in-production-use-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite (تطوير محلي)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# MySQL (Namecheap / إنتاج)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=mobihull_mobiledb
# DB_USER=mobihull_aser
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# PostgreSQL (بديل)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=mobishop
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

TRIAL_DAYS=14
LOW_STOCK_DEFAULT=5

# المساعد الذكي — analytics (قوالب + بيانات حقيقية) | openai | gemini | local
# لردود أذكى وأكثر احترافية: عيّن مزوّداً خارجياً + المفتاح (لا تضعه في الواجهة الأمامية)
LLM_PROVIDER=analytics
# AI_PROVIDER_API_KEY=   # اسم عام اختياري؛ يُفضّل المفتاح الخاص بالمزوّد
# --- OpenAI (موصى به للإنتاج) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.35
# OPENAI_MAX_TOKENS=900
# --- Google Gemini (مفتاح من https://aistudio.google.com/apikey) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TEMPERATURE=0.35
# GEMINI_MAX_TOKENS=1200
# --- Ollama محلي ---
# LLM_PROVIDER=local
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=llama3
# حد الرسائل: DEFAULT_THROTTLE_RATES.assistant_chat في settings (افتراضي 40/hour)
